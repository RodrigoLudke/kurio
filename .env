# Camada de mocks (MSW REST + Socket.IO). Ativa por padrão: a entrega não depende de backend real.
VITE_ENABLE_MOCKS=true
# Base das rotas REST consumidas pelo Axios
VITE_API_BASE_URL=/api
# Endpoint Socket.IO (interceptado pelo MSW quando VITE_ENABLE_MOCKS=true)
VITE_REALTIME_URL=wss://realtime.kurio.mock
# Exibe o painel de simulação (cenários, rede e eventos do servidor simulado)
VITE_MOCK_PANEL=true
# Timeout das requisições HTTP (ms)
VITE_HTTP_TIMEOUT_MS=8000
